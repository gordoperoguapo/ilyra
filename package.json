{
  "name": "ilyra",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop AI launcher: bring your own keys for Claude, ChatGPT, Gemini and Meta, and use them all in one place.",
  "scripts": {
    "start": "electron .",
    "preview": "node server.js",
    "icon": "electron scripts/make-icon.js",
    "predist": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "dist": "electron-builder --win",
    "postdist": "node -e \"const fs=require('fs');for(const f of fs.readdirSync('release'))if(!f.endsWith('.exe'))fs.rmSync('release/'+f,{recursive:true,force:true})\"",
    "test": "node test/mcp.test.js && node test/mcp-oauth.test.js && node test/location.test.js && node test/vad.test.js && node test/usage.test.js && node test/tone.test.js && node test/chat.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "author": "Ilyra",
  "build": {
    "appId": "app.ilyra.hub",
    "productName": "Ilyra",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "web/**",
      "package.json",
      "build/icon.png",
      "!**/*.map",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/@img/sharp-linux-*/**",
      "!node_modules/@img/sharp-libvips-linux-*/**",
      "!node_modules/@img/sharp-darwin-*/**",
      "!node_modules/@img/sharp-libvips-darwin-*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ilyra",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "Ilyra-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  }
}
